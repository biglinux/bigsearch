# Maintainer: Bruno Gonçalves <www.biglinux.com.br>
pkgname=big-docinfo
pkgver=r32.db561ab
pkgrel=1
pkgdesc="Suggests a file name for a document from what it says, with a Dolphin menu; no AI model"
arch=('x86_64')
url="https://github.com/biglinux/bigsearch"
license=('MIT')
depends=('glibc' 'libgcc' 'poppler' 'kdialog' 'sh')
optdepends=('dolphin: the "Suggest a name…" menu')
makedepends=('cargo' 'pkgconf' 'python')
source=()
sha256sums=()

# Where cargo builds; build(), check() and package() must agree on it.
_target="${BIG_CARGO_TARGET_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd -P)/target}"

_package_dir() {
    cd "$(dirname "${BASH_SOURCE[0]}")"
    pwd -P
}

_project_dir() {
    cd "${BIG_DOCINFO_SOURCE:-$(_package_dir)/../..}"
    pwd -P
}

pkgver() {
    cd "$(_project_dir)"
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    else
        printf '%s' "$pkgver"
    fi
}

prepare() {
    cd "$(_project_dir)"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$(_project_dir)"
    CARGO_INCREMENTAL=0 cargo build --frozen --release --target-dir "$_target" -p big-docinfo-cli
}

check() {
    cd "$(_project_dir)"
    export TMPDIR="$(_package_dir)/test-tmp"
    mkdir -p "$TMPDIR"
    CARGO_INCREMENTAL=0 cargo test --frozen --release --target-dir "$_target" -p big-docinfo-cli -p big-docinfo
}

package() {
    cd "$(_project_dir)"
    install -Dm755 "$_target/release/big-docinfo" "$pkgdir/usr/bin/big-docinfo"
    install -Dm755 packaging/suggest-name "$pkgdir/usr/lib/big-docinfo/suggest-name"
    install -Dm644 packaging/big-docinfo.desktop "$pkgdir/usr/share/kio/servicemenus/big-docinfo.desktop"

    install -Dm644 ../../LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    CARGO_NET_OFFLINE=true python ../../scripts/third-party-notices.py \
        --package big-docinfo-cli \
        --target "$(rustc -vV | sed -n 's/host: //p')" \
        > "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES"
}
