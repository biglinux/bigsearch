[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/pdf;application/vnd.oasis.opendocument.text;application/vnd.openxmlformats-officedocument.wordprocessingml.document;text/plain;text/markdown;
Actions=SuggestName;
X-KDE-Priority=TopLevel
Icon=edit-rename

[Desktop Action SuggestName]
Icon=edit-rename
Name=Suggest a name…
Name[es]=Sugerir un nombre…
Name[pt]=Sugerir nome…
Name[pt_BR]=Sugerir nome…
Exec=/usr/lib/big-docinfo/suggest-name %f
