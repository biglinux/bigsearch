#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "„{name}” nie może być nazwą pliku. Użyj nazwy bez ukośników."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Ta nazwa jest za długa. Użyj krótszej nazwy."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"W tym folderze istnieje już plik o nazwie „{name}”. Wybierz inną nazwę."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Na tym dysku nie można zmienić nazwy bez ryzyka usunięcia innego pliku. "
"Zmień nazwę w menedżerze plików."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Nie można zmienić nazwy: {error}."

#: packaging/suggest-name
