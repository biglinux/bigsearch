#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "«{name}» non può essere un nome di file. Usa un nome senza barre."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Questo nome è troppo lungo. Usa un nome più corto."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"In questa cartella esiste già un file chiamato «{name}». Scegli un altro "
"nome."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Questo disco non permette di rinominare senza rischiare di cancellare un "
"altro file. Rinominalo dal gestore di file."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Impossibile rinominare: {error}."

