#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "„{name}“ getur ekki verið skráarheiti. Notaðu heiti án skástrika."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Heitið er of langt. Notaðu styttra heiti."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"Skrá sem heitir „{name}“ er þegar til í þessari möppu. Veldu annað heiti."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Þessi diskur leyfir ekki endurnefningu án hættu á að eyða annarri skrá. "
"Endurnefndu hana í skráastjóranum."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Ekki tókst að endurnefna: {error}."

#: packaging/suggest-name
msgid "Suggest a name"
msgstr "Stinga upp á heiti"

