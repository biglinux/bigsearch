#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "”{name}” ei kelpaa tiedostonimeksi. Käytä nimeä ilman kauttaviivoja."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Nimi on liian pitkä. Käytä lyhyempää nimeä."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr "Kansiossa on jo tiedosto nimeltä ”{name}”. Valitse toinen nimi."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Tällä levyllä nimeä ei voi vaihtaa vaarantamatta toista tiedostoa. Vaihda "
"nimi tiedostonhallinnassa."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Nimen vaihtaminen epäonnistui: {error}."

