#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr ""
"„{name}“ kann kein Dateiname sein. Verwenden Sie einen Namen ohne "
"Schrägstriche."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Dieser Name ist zu lang. Verwenden Sie einen kürzeren Namen."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"In diesem Ordner gibt es bereits eine Datei namens „{name}“. Wählen Sie "
"einen anderen Namen."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Auf diesem Datenträger lässt sich nicht umbenennen, ohne eine andere Datei "
"zu gefährden. Benennen Sie die Datei im Dateimanager um."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Umbenennen nicht möglich: {error}."

