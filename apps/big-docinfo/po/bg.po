#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr ""
"„{name}“ не може да бъде име на файл. Използвайте име без наклонени черти."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Това име е твърде дълго. Използвайте по-кратко име."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr "В тази папка вече има файл с име „{name}“. Изберете друго име."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Този диск не позволява преименуване без риск за друг файл. Преименувайте го "
"от файловия мениджър."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Преименуването не бе успешно: {error}."

