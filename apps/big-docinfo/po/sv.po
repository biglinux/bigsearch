#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "”{name}” kan inte vara ett filnamn. Använd ett namn utan snedstreck."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Namnet är för långt. Använd ett kortare namn."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"Det finns redan en fil med namnet ”{name}” i mappen. Välj ett annat namn."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"På den här disken går det inte att byta namn utan risk att radera en annan "
"fil. Byt namn på den i filhanteraren."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Kunde inte byta namn: {error}."

