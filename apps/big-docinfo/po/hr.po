#: src/main.rs
msgid "This name has characters a file name cannot hold. Choose another name."
msgstr ""
"Ovaj naziv sadrži znakove koje naziv datoteke ne smije imati. Odaberite "
"drugi naziv."

#: src/main.rs
msgid "This file is no longer there: it was moved or deleted."
msgstr "Ova datoteka više nije ondje: premještena je ili izbrisana."

#: src/main.rs
msgid "You do not have permission to read this file."
msgstr "Nemate dopuštenje za čitanje ove datoteke."

#: src/main.rs
msgid "This file could not be read."
msgstr "Ovu datoteku nije moguće pročitati."

#: src/main.rs
msgid ""
"This file has no readable text: its type is not supported, or it is a "
"scanned PDF."
msgstr ""
"Ova datoteka nema čitljiv tekst: vrsta nije podržana ili je riječ o "
"skeniranom PDF-u."

