#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "„{name}” ne može biti naziv datoteke. Koristite naziv bez kosih crta."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Ovaj je naziv predug. Koristite kraći naziv."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr "U ovoj mapi već postoji datoteka „{name}”. Odaberite drugi naziv."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Na ovom disku nije moguće preimenovati bez opasnosti za drugu datoteku. "
"Preimenujte je u upravitelju datoteka."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Preimenovanje nije uspjelo: {error}."

