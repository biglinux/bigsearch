#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "„{name}“ nemůže být název souboru. Použijte název bez lomítek."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Tento název je příliš dlouhý. Použijte kratší název."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"V této složce již existuje soubor s názvem „{name}“. Zvolte jiný název."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Na tomto disku nelze přejmenovat bez rizika smazání jiného souboru. "
"Přejmenujte jej ve správci souborů."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Přejmenování se nezdařilo: {error}."

