#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "«{name}» не может быть именем файла. Используйте имя без косых черт."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Это имя слишком длинное. Используйте более короткое имя."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr "В этой папке уже есть файл с именем «{name}». Выберите другое имя."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Этот диск не позволяет переименовать файл без риска удалить другой. "
"Переименуйте его в файловом менеджере."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Не удалось переименовать: {error}."

