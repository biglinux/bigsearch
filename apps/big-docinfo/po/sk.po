#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "„{name}“ nemôže byť názov súboru. Použite názov bez lomiek."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Tento názov je príliš dlhý. Použite kratší názov."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"V tomto priečinku už existuje súbor s názvom „{name}“. Zvoľte iný názov."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Na tomto disku nemožno premenovať bez rizika vymazania iného súboru. "
"Premenujte ho v správcovi súborov."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Premenovanie zlyhalo: {error}."

