#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "»{name}« kan ikke bruges som filnavn. Brug et navn uden skråstreger."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Navnet er for langt. Brug et kortere navn."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"Der findes allerede en fil med navnet »{name}« i mappen. Vælg et andet navn."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Dette drev kan ikke omdøbe uden risiko for at slette en anden fil. Omdøb den "
"i filhåndteringen."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Kunne ikke omdøbe: {error}."

