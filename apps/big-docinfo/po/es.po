#: src/main.rs
msgid "This name has characters a file name cannot hold. Choose another name."
msgstr ""
"Ese nombre tiene caracteres que un nombre de archivo no admite. Elija otro "
"nombre."

#: src/main.rs
msgid "This file is no longer there: it was moved or deleted."
msgstr "Este archivo ya no está ahí: se movió o se eliminó."

#: src/main.rs
msgid "You do not have permission to read this file."
msgstr "No tiene permiso para leer este archivo."

#: src/main.rs
msgid "This file could not be read."
msgstr "No se pudo leer este archivo."

#: src/main.rs
msgid ""
"This file has no readable text: its type is not supported, or it is a "
"scanned PDF."
msgstr ""
"Este archivo no tiene texto legible: su tipo no es compatible o es un PDF "
"escaneado."

