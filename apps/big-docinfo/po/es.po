#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "«{name}» no sirve como nombre de archivo. Use un nombre sin barras."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Ese nombre es demasiado largo. Use un nombre más corto."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"Ya existe un archivo llamado «{name}» en esta carpeta. Elija otro nombre."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Este disco no permite renombrar sin riesgo de borrar otro archivo. "
"Renómbrelo en el gestor de archivos."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "No se pudo renombrar: {error}."

