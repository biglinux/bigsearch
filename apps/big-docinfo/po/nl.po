#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr ""
"‘{name}’ kan geen bestandsnaam zijn. Gebruik een naam zonder schuine strepen."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Deze naam is te lang. Gebruik een kortere naam."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"Er bestaat al een bestand met de naam ‘{name}’ in deze map. Kies een andere "
"naam."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Op deze schijf kan niet worden hernoemd zonder risico voor een ander "
"bestand. Hernoem het in de bestandsbeheerder."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Hernoemen mislukt: {error}."

