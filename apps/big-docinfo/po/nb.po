#: src/main.rs
msgid "This name has characters a file name cannot hold. Choose another name."
msgstr "Navnet inneholder tegn som et filnavn ikke kan ha. Velg et annet navn."

#: src/main.rs
msgid "This file is no longer there: it was moved or deleted."
msgstr "Filen er ikke der lenger: den ble flyttet eller slettet."

#: src/main.rs
msgid "You do not have permission to read this file."
msgstr "Du har ikke tillatelse til å lese denne filen."

#: src/main.rs
msgid "This file could not be read."
msgstr "Kunne ikke lese filen."

#: src/main.rs
msgid ""
"This file has no readable text: its type is not supported, or it is a "
"scanned PDF."
msgstr ""
"Filen har ingen lesbar tekst: filtypen støttes ikke, eller det er en skannet "
"PDF."

