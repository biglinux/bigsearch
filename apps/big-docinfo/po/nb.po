#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "«{name}» kan ikke være et filnavn. Bruk et navn uten skråstreker."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Navnet er for langt. Bruk et kortere navn."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"Det finnes allerede en fil med navnet «{name}» i denne mappen. Velg et annet "
"navn."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"På denne disken kan ikke filen få nytt navn uten fare for å slette en annen "
"fil. Gi den nytt navn i filbehandleren."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Kunne ikke gi nytt navn: {error}."

#: packaging/suggest-name
