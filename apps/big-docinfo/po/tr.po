#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "“{name}” dosya adı olamaz. Eğik çizgi içermeyen bir ad kullanın."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Bu ad çok uzun. Daha kısa bir ad kullanın."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr "Bu klasörde “{name}” adlı bir dosya zaten var. Başka bir ad seçin."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Bu disk, başka bir dosyayı silme riski olmadan yeniden adlandırmaya izin "
"vermiyor. Dosya yöneticisinden yeniden adlandırın."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Yeniden adlandırılamadı: {error}."

