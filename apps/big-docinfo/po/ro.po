#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr ""
"„{name}” nu poate fi nume de fișier. Folosiți un nume fără bare oblice."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Acest nume este prea lung. Folosiți un nume mai scurt."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr "Există deja un fișier numit „{name}” în acest dosar. Alegeți alt nume."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Acest disc nu permite redenumirea fără riscul de a șterge alt fișier. "
"Redenumiți-l din managerul de fișiere."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Redenumirea a eșuat: {error}."

