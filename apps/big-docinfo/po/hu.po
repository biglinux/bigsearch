#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "„{name}” nem lehet fájlnév. Használjon perjel nélküli nevet."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Ez a név túl hosszú. Használjon rövidebb nevet."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr "Ebben a mappában már van „{name}” nevű fájl. Válasszon másik nevet."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Ezen a lemezen nem lehet átnevezni egy másik fájl veszélyeztetése nélkül. "
"Nevezze át a fájlkezelőben."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Az átnevezés nem sikerült: {error}."

