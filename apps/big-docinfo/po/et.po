#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "„{name}“ ei sobi failinimeks. Kasuta kaldkriipsudeta nime."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "See nimi on liiga pikk. Kasuta lühemat nime."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr "Selles kaustas on juba fail nimega „{name}“. Vali teine nimi."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Sellel kettal ei saa ümber nimetada ilma teist faili ohustamata. Nimeta see "
"ümber failihalduris."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Ümbernimetamine ebaõnnestus: {error}."

