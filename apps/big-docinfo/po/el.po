#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr ""
"Το «{name}» δεν μπορεί να είναι όνομα αρχείου. Χρησιμοποιήστε όνομα χωρίς "
"καθέτους."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Αυτό το όνομα είναι πολύ μεγάλο. Χρησιμοποιήστε συντομότερο όνομα."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"Υπάρχει ήδη αρχείο με όνομα «{name}» σε αυτόν τον φάκελο. Επιλέξτε άλλο "
"όνομα."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Αυτός ο δίσκος δεν επιτρέπει μετονομασία χωρίς κίνδυνο για άλλο αρχείο. "
"Μετονομάστε το από τη διαχείριση αρχείων."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Η μετονομασία απέτυχε: {error}."

#: packaging/suggest-name
msgid "Suggest a name"
msgstr "Πρόταση ονόματος"

