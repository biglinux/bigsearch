#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr "«{name}» não pode ser nome de ficheiro. Use um nome sem barras."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Esse nome é demasiado longo. Use um nome mais curto."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"Já existe um ficheiro chamado «{name}» nesta pasta. Escolha outro nome."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Este disco não permite mudar o nome sem risco de apagar outro ficheiro. Mude "
"o nome no gestor de ficheiros."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Não foi possível mudar o nome: {error}."

