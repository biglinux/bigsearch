#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr ""
"«{name}» не може бути назвою файлу. Використайте назву без скісних рисок."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Ця назва задовга. Використайте коротшу назву."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr "У цій теці вже є файл із назвою «{name}». Виберіть іншу назву."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Цей диск не дає змоги перейменувати файл без ризику видалити інший. "
"Перейменуйте його у файловому менеджері."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Не вдалося перейменувати: {error}."

