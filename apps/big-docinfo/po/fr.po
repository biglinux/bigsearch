#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid "“{name}” cannot be a file name. Use a name without slashes."
msgstr ""
"« {name} » ne peut pas servir de nom de fichier. Utilisez un nom sans barre "
"oblique."

#: src/main.rs
msgid "This name is too long. Use a shorter name."
msgstr "Ce nom est trop long. Utilisez un nom plus court."

#. Translators: keep {name} as written; it is the name the person typed.
#: src/main.rs
#, rust-format
msgid ""
"A file named “{name}” already exists in this folder. Choose another name."
msgstr ""
"Un fichier nommé « {name} » existe déjà dans ce dossier. Choisissez un autre "
"nom."

#: src/main.rs
msgid ""
"This disk cannot rename without risking another file. Rename it in the file "
"manager."
msgstr ""
"Ce disque ne permet pas de renommer sans risquer d’effacer un autre fichier. "
"Renommez-le dans le gestionnaire de fichiers."

#. Translators: keep {error} as written; the system fills in why.
#: src/main.rs
#, rust-format
msgid "Could not rename: {error}."
msgstr "Impossible de renommer : {error}."

