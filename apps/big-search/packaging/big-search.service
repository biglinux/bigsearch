# systemd user unit: install to ~/.config/systemd/user/big-search.service,
# then run `systemctl --user enable --now big-search.service`.
#
# Runs unprivileged. Indexing threads lower themselves (idle cgroup, SCHED_IDLE,
# clock clamp, idle I/O; throttle.rs), so the unit sets no Nice,
# CPUSchedulingPolicy or low CPUWeight: searching runs like a normal program.
[Unit]
Description=big-search file index daemon
Documentation=https://github.com/biglinux/bigsearch

[Service]
Type=simple
ExecStart=%h/.local/bin/big-search daemon
Restart=on-failure
RestartSec=5
UMask=0077
Environment=RUST_LOG=info,tantivy=warn,symphonia_core=error,symphonia_format_isomp4=error,symphonia_bundle_mp3=error
# Provenance (`[origin]`) and metadata extraction (`metadata`) stay out of
# Environment=: config.toml owns them, and an environment variable would win
# over the user's config and turn that setting into a no-op.
# MemoryHigh reclaims page cache first; MemoryMax is the safety net. The
# extraction pool's bounded queue keeps anonymous memory low.
# The cpu controller is handed to the daemon, which runs in <unit>/main and puts
# its indexing threads in a threaded child group with cpu.idle: indexing takes
# only CPU time nobody else wants, searching keeps a normal program's share. A
# thread's SCHED_IDLE alone counts only inside its cgroup (DESIGN.md, section 7).
Delegate=cpu
DelegateSubgroup=main
IOAccounting=yes
IOWeight=20
MemoryHigh=512M
MemoryMax=768M
TasksMax=64

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# Writable paths: only the daemon's data dir (index, state, history and
# SQLITE_TMPDIR) and the socket dir, the standard paths the CLI finds too.
# Anything wider lets a parser compromised by an indexed file plant units,
# .desktop or D-Bus service files that run outside the sandbox. The `+` runs the
# mkdir before the sandbox applies, since ReadWritePaths= needs the paths to
# exist. A custom XDG_DATA_HOME in the service environment is not covered.
ExecStartPre=+/usr/bin/mkdir -p -m 0700 %h/.local/share/big-search %t/biglinux
ReadWritePaths=%h/.local/share/big-search %t/biglinux
# Private writable /tmp: with ProtectSystem=strict and ProtectHome=read-only
# every default temp dir is read-only, and SQLite cannot spill
# (SQLITE_IOERR_GETTEMPPATH), which aborts the startup reconcile. The daemon
# sets SQLITE_TMPDIR to its data dir; this covers any other temp user (poppler).
PrivateTmp=yes
# A cgroup namespace of its own: the daemon sees only its unit's subtree, and may
# write there to give its indexing threads their idle group (see Delegate=).
ProtectControlGroups=private
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @reboot @swap @obsolete

[Install]
WantedBy=default.target
